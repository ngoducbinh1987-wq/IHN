# Mẫu cấu hình gateway. Chép thành .env (không commit), điền giá trị thật tại máy chủ nhà máy.
# Nơi nhận dữ liệu (chốt ở README mục 5): một trong hai cách
SUPABASE_URL=https://awjbtcvpzjjxdczepwyr.supabase.co
# Cách 1: kết nối Postgres bằng role riêng bmt_gateway (chỉ gọi được iot.ingest_batch)
GATEWAY_DB_URL=
# Cách 2: khóa riêng cho API ghi dữ liệu máy
GATEWAY_API_KEY=

# Nhịp đọc và gửi
POLL_MS=1000
BATCH_MS=10000
# Thư mục đệm khi mất mạng (giữ ít nhất 24 giờ)
BUFFER_DIR=./buffer

# Danh sách tag từng máy
TAGS_FILE=./tags.csv
